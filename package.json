{
  "name": "nexugen",
  "version": "0.4.0",
  "description": "Nexugen API client: projects, builds, edits, deploys and Pilot, with streaming turns, webhook verification, and Pilot for your users in any app (nexugen/react).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "nexugen",
    "pilot",
    "ai",
    "sdk",
    "app-builder",
    "react",
    "chatbot",
    "agent",
    "assistant"
  ],
  "homepage": "https://github.com/Nexugen/nexugen-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nexugen/nexugen-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Nexugen/nexugen-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
